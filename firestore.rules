rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    // Perfil del usuario que hace la petición, buscado por su correo
    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data;
    }

    function esAdmin() {
      return estaAutenticado() && miPerfil().rol == 'admin';
    }

    // ---- Perfiles de usuario (nombre, rol, activo) ----
    // Cualquier persona autenticada puede leer perfiles (para saber roles),
    // pero solo el administrador puede crear/editar perfiles.
    match /usuarios/{email} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // ---- Flotas ----
    // Todos leen; solo el administrador agrega o desactiva flotas.
    match /flotas/{id} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // ---- Liquidaciones (captura) ----
    // Analistas, Liquidaciones y Admin pueden leer y escribir (capturar/editar).
    match /liquidaciones/{id} {
      allow read, write: if estaAutenticado();
    }

    // ---- Cortes ----
    match /cortes/{id} {
      allow read, write: if estaAutenticado();
    }

    // ---- Bitácora de auditoría ----
    // Todos pueden agregar entradas (se generan automáticamente al capturar/editar),
    // pero nadie debe poder modificar o borrar el historial ya escrito.
    match /bitacora/{id} {
      allow read, create: if estaAutenticado();
      allow update, delete: if false;
    }
  }
}
